{
  "name": "racoon-typper-frontend",
  "version": "1.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --port 1420 --strictPort",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test:profile-transfer-ui": "node --experimental-strip-types --test ../scripts/profile-transfer-ui.test.mjs",
    "test:ui": "node --experimental-strip-types --test ../scripts/profile-transfer-ui.test.mjs ../scripts/lesson-navigation-ui.test.mjs ../scripts/theme-pack.test.mjs",
    "preview": "vite preview",
    "check:version": "node ../scripts/check-version.mjs",
    "check:ipc-contracts": "node ../scripts/check-ipc-contracts.mjs",
    "license:check": "node ../scripts/license-policy.mjs --check",
    "tauri:dev": "node ../scripts/tauri.mjs dev",
    "tauri:build": "node ../scripts/tauri.mjs build",
    "tauri:build:ci": "node ../scripts/tauri.mjs build --ci",
    "tauri:build:binary": "node ../scripts/tauri.mjs build --ci --no-bundle"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tauri-apps/cli": "^2.11.3",
    "@tsconfig/svelte": "^5.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tslib": "^2.6.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1"
  }
}
