# Normalize all text files to LF on checkout, regardless of host platform.
# Windows checkout with core.autocrlf would otherwise introduce CRLF, which
# breaks line-sensitive tools such as scripts/check-version.mjs.
* text=auto eol=lf

# Binary assets must never be normalized.
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary

# Preserve the byte-identical upstream MIT license, including its final blank line.
vendor/glib-0.18.5/LICENSE whitespace=-blank-at-eof
vendor/glib-macros-0.18.5/LICENSE whitespace=-blank-at-eof
vendor/gtk3-macros-0.18.2/LICENSE whitespace=-blank-at-eof

# Unified patches contain space-prefixed blank context and verbatim removed lines.
patches/glib-macros-0.18.5-syn-diagnostics.patch whitespace=-blank-at-eol
patches/gtk3-macros-0.18.2-syn-diagnostics.patch whitespace=-blank-at-eol
