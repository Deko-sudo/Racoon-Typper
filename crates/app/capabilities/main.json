{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local main window — explicitly allow only frontend IPC commands",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "allow-abort-session",
    "allow-abandon-active-session",
    "allow-analyze-weak-keys",
    "allow-delete-custom-text",
    "allow-export-data",
    "allow-export-heatmap-png",
    "allow-export-result-png",
    "allow-export-profile",
    "allow-export-report",
    "allow-generate-weak-keys-training",
    "allow-get-achievements",
    "allow-get-aggregated-heatmap",
    "allow-clear-statistics",
    "allow-get-consistency",
    "allow-get-course",
    "allow-get-custom-texts",
    "allow-get-dashboard-stats",
    "allow-get-insights",
    "allow-get-lesson-progress",
    "allow-get-personal-bests",
    "allow-get-progress-history",
    "allow-get-replay",
    "allow-get-settings",
    "allow-get-sound-event",
    "allow-get-stats-history",
    "allow-get-theme-css",
    "allow-get-themes",
    "allow-import-profile",
    "allow-preview-profile-import",
    "allow-restore-database",
    "allow-process-key",
    "allow-save-custom-text",
    "allow-search-custom-texts",
    "allow-set-setting",
    "allow-start-custom-text-test",
    "allow-start-lesson",
    "allow-start-test",
    "allow-update-custom-text",
    "dialog:allow-open",
    "fs:allow-read-text-file",
    "clipboard-manager:allow-read-text",
    "allow-import-text-from-url"
  ]
}